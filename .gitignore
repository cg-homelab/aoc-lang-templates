.codegraph
# Per-day files from running a template in place: never commit a puzzle
# input to this public repo (and the fallback copy would spread it).
/templates/*/input.txt
/templates/*/bench.md
/templates/*/bench.json

# Build artifacts from building a template in place
/templates/**/Cargo.lock
/templates/**/uv.lock
/templates/**/target/
/templates/**/node_modules/
/templates/**/.venv/
/templates/**/__pycache__/
# The toolkit's own uv project: venv created by `uv run --project`, build output, tool caches.
# uv.lock at the root IS committed.
/.venv/
/dist/
/.ruff_cache/
/.pytest_cache/
__pycache__/
*.pyc
/templates/**/*.pyc
/templates/**/.pytest_cache/
/templates/*/solution

# .NET / Zig build artifacts
/templates/**/bin/
/templates/**/obj/
/templates/**/out/
/templates/**/TestResults/
/templates/**/.zig-cache/
/templates/**/zig-out/
# mlugg/setup-zig points ZIG_GLOBAL_CACHE_DIR and ZIG_LOCAL_CACHE_DIR at the workspace root
/.zig-cache/

# macOS
.DS_Store

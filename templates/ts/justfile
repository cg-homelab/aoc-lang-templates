# __NAME__ (typescript, bun)

build:
    bun build --compile --outfile solution main.ts

run part:
    bun main.ts {{part}}

test:
    bun test

bench: build
    hyperfine -N --warmup 3 --export-markdown bench.md \
        -n '__NAME__ part1' './solution 1' \
        -n '__NAME__ part2' './solution 2'

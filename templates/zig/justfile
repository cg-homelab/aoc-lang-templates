# __NAME__

build:
    zig build -Doptimize=ReleaseFast

run part: build
    ./zig-out/bin/__NAME__ {{part}}

test:
    zig build test

bench: build
    hyperfine -N --warmup 3 --export-markdown bench.md \
        -n '__NAME__ part1' './zig-out/bin/__NAME__ 1' \
        -n '__NAME__ part2' './zig-out/bin/__NAME__ 2'

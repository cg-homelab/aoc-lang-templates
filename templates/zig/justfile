# day-__DAY__ — zig

build:
    zig build -Doptimize=ReleaseFast

run part: build
    ./zig-out/bin/day-__DAY__ {{part}}

test:
    zig build test

bench: build
    hyperfine -N --warmup 3 --export-markdown bench.md \
        -n 'day-__DAY__ zig part1' './zig-out/bin/day-__DAY__ 1' \
        -n 'day-__DAY__ zig part2' './zig-out/bin/day-__DAY__ 2'

# __NAME__ (.NET 10; bench uses a Native AOT publish)

build:
    dotnet publish src -c Release -o out

run part:
    dotnet run --project src -c Release -- {{part}}

test:
    dotnet test tests

bench: build
    hyperfine -N --warmup 3 --export-markdown bench.md \
        -n '__NAME__ part1' './out/__NAME__ 1' \
        -n '__NAME__ part2' './out/__NAME__ 2'

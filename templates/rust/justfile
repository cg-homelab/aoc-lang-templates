# __NAME__

build:
    cargo build --release --quiet

run part:
    cargo run --release --quiet -- {{part}}

test:
    cargo test --quiet

bench: build
    hyperfine -N --warmup 3 --export-markdown bench.md \
        -n '__NAME__ part1' './target/release/__NAME__ 1' \
        -n '__NAME__ part2' './target/release/__NAME__ 2'

# day-__DAY__ — fsharp (.NET 10; bench uses a Native AOT publish)

build:
    dotnet publish src -c Release -o out

run part:
    dotnet run --project src -c Release -- {{part}}

test:
    dotnet test tests

bench: build
    hyperfine -N --warmup 3 --export-markdown bench.md \
        -n 'day-__DAY__ fsharp part1' './out/day-__DAY__ 1' \
        -n 'day-__DAY__ fsharp part2' './out/day-__DAY__ 2'

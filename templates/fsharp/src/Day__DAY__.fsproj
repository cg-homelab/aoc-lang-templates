<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Binary is day-NN like the other templates. -->
    <AssemblyName>day-__DAY__</AssemblyName>
    <!-- `just build` / `just bench` publish a Native AOT binary to out/.
         InvariantGlobalization drops ICU and keeps the binary small. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- FSharp.Core is not fully trim/AOT annotated, so ILCompiler emits one
         collapsed "assembly produced warnings" per category (IL2104 trimming,
         IL3053 AOT). They are not actionable from this project; silence them.
         Set <TrimmerSingleWarn>false</TrimmerSingleWarn> temporarily to see
         the individual warnings when debugging an AOT problem. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    <!-- Skip FSharp.Core's localized resource satellites in bin/. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Part1.fs" />
    <Compile Include="Part2.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>

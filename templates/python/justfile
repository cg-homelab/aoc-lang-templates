# __NAME__ (uv)

build:
    uv sync --quiet

run part: build
    uv run --quiet --no-sync main.py {{part}}

test: build
    uv run --quiet --no-sync pytest -q

# Benches the venv python directly — no uv wrapper overhead in the numbers.
bench: build
    hyperfine -N --warmup 3 --export-markdown bench.md \
        -n '__NAME__ part1' '.venv/bin/python main.py 1' \
        -n '__NAME__ part2' '.venv/bin/python main.py 2'

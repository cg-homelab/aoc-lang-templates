# __NAME__ (uv)

solution := ".venv/bin/python main.py"
toolkit := env("AOC_TOOLKIT", "../../toolkit")

build:
    uv sync --quiet

run part: build
    uv run --quiet --no-sync main.py {{part}}

test: build
    uv run --quiet --no-sync pytest -q

# In-process timing of both parts (+ hyperfine wall time if installed) -> bench.json
# The day's venv python is run directly as the harness; uv only launches the driver, so no wrapper overhead is in the numbers.
bench *args: build
    uv run --quiet --frozen --no-dev --project "{{toolkit}}" aoc-toolkit bench --name __NAME__ {{args}} -- {{solution}}

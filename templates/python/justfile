# __NAME__ (uv)

solution := ".venv/bin/python main.py"
scripts := env("AOC_SCRIPTS", "../../lang-templates/scripts")

build:
    uv sync --quiet

run part: build
    uv run --quiet --no-sync main.py {{part}}

test: build
    uv run --quiet --no-sync pytest -q

# In-process timing of both parts (+ hyperfine wall time if installed) -> bench.json
# Runs the venv python directly — no uv wrapper overhead in the numbers.
bench *args: build
    python3 "{{scripts}}/bench_day.py" --name __NAME__ {{args}} -- {{solution}}
